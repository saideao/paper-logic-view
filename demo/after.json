  "paper": {"title": "面向新站点的共享单车需求预测（改后）", "source": "虚构示例，演示用", "license": "CC0"},
  "summary": "新站点没有历史订单；借周边环境相似的老站点的需求曲线来预测，在两个城市的新站点上误差低于两类现有方法。能否直接上线留作后续验证。",
  "annotations": [
    {"id":"bg1","page":1,"type":"background","importance":1,"quote":"共享单车已经成为城市短途出行的主要方式之一","note":"交代场景。"},
    {"id":"bg2","page":1,"type":"background","importance":2,"quote":"调度得好不好，取决于对每个站点未来需求的预测","note":"为什么要做需求预测。"},
    {"id":"hist","page":1,"type":"background","importance":2,"quote":"现有的预测方法大多基于历史订单训练","note":"现有方法的做法。"},
    {"id":"p_new","page":1,"type":"problem","importance":3,"quote":"新站点刚投放，没有历史订单，这些方法就无从下手","note":"全文要解决的问题，中间那一步补上了。"},
    {"id":"grow","page":1,"type":"claim","importance":2,"quote":"这个问题并不少见","note":"问题值得做。"},
